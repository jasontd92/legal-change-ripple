# Copy to .env.local (git-ignored). The harness loads .env.local, then .env.

# Vercel AI Gateway: used for any model id with a provider prefix,
# e.g. zai/glm-5.3-flash, deepseek/deepseek-v4.1-flash (the default configs).
AI_GATEWAY_API_KEY=

# TypeSafe (Jev) classifier: only needed for configs/j-jev.json.
TYPESAFE_API_KEY=

# Optional: direct provider keys, used instead of the gateway for
# model ids starting with claude-* or gpt-* (see README, "Direct API keys").
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
